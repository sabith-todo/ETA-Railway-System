# Environment Configuration for Indian Railways Dynamic ETA Forecast Engine
# SIH Problem Statement ID: 26028 | Ministry of Railways

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Database (SQLite by default, seamlessly switchable to PostgreSQL)
DATABASE_URL=sqlite:///./backend/railway_eta.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/railway_eta

# Simulation Settings
SIMULATION_TICK_INTERVAL_SEC=5
SIMULATION_AUTOSTART=true

# Data Provider Mode: 'simulation', 'railradar', or 'official'
DATA_PROVIDER_MODE=simulation
CRIS_API_ENDPOINT=https://api.cris.org.in/v1/telemetry
CRIS_API_KEY=

# RailRadar API Gateway (https://api.railradar.in/v1)
# Bearer Token format: rr_live_... or rg_...
RAILRADAR_API_BASE=https://api.railradar.in/v1
RAILRADAR_API_KEY=rg_286bf91dd4a44a3ea29585b72f1c0dac

# Railway API Integration Layer
RAILWAY_API_BASE_URL=https://api.railway.example.com
RAILWAY_API_KEY=

# Optional RapidAPI IRCTC live fallback key
RAPID_API_KEY=d0f527d5f0msh19642ae8f0083edp1a3a10jsnd57e85f3849e
